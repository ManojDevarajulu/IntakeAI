# ==============================================================================
# INTAKE AI — CLINICAL DOCUMENT IDP & CONFORMAL RISK ROUTING CONFIGURATION
# ==============================================================================
# Copy this file to '.env' to customize runtime settings, plug in your own
# Vision LLMs (Gemini, OpenAI, Anthropic, Ollama), or connect to an EHR endpoint.
# Default settings run 100% offline with zero API keys required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8001
DEBUG=false
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. PLUGGABLE OCR ENGINE BACKEND
# ------------------------------------------------------------------------------
# Options:
#   - 'auto'            : Automatically selects Windows Native OCR -> Heuristic fallback
#   - 'native'          : Hardware-accelerated Windows.Media.Ocr.OcrEngine
#   - 'tesseract'       : Local Tesseract-OCR CLI (/usr/bin/tesseract)
#   - 'multimodal_llm'  : Direct zero-shot extraction via Vision LLM (see Section 3)
OCR_BACKEND=auto

# ------------------------------------------------------------------------------
# 3. MULTIMODAL VISION LLM EXTRACTION (OPTIONAL)
# ------------------------------------------------------------------------------
# Intake AI uses a Neurosymbolic architecture:
# If enabled, the Vision LLM extracts semantic key-value entities, and the output
# is strictly gated by the deterministic CMS Luhn, ICD-10, and chronology verifiers.
#
# Options: 'none' | 'gemini' | 'openai' | 'anthropic' | 'ollama'
LLM_PROVIDER=none

# Google Gemini (Gemini 2.5 Flash / Pro)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI GPT-4o (Vision)
# Obtain key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude 3.5 (Vision)
# Obtain key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama (Self-Hosted Vision Models)
# Run locally: ollama run llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ------------------------------------------------------------------------------
# 4. CONFORMAL RISK ROUTING & SAFETY THRESHOLDS
# ------------------------------------------------------------------------------
# Target safety coverage: 1 - alpha (e.g., alpha=0.05 guarantees 95% safety coverage)
CONFORMAL_ALPHA=0.05

# Minimum confidence required for overall document auto-acceptance (STP)
MIN_OVERALL_CONFIDENCE=0.85

# Critical clinical fields (NPI, ICD-10, Patient DOB) must strictly satisfy this threshold
MIN_CRITICAL_CONFIDENCE=0.88

# ------------------------------------------------------------------------------
# 5. HL7 FHIR R4 & DOWNSTREAM EHR INTEGRATION
# ------------------------------------------------------------------------------
# Optional FHIR R4 Endpoint for direct transaction bundle dispatch on approval:
# Examples: 'https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4'
EHR_FHIR_ENDPOINT=

# Webhook URL dispatched when a clinician signs off / overrides a flagged referral:
WEBHOOK_ON_APPROVAL=

# Enable HIPAA audit trail logging for all ingestion and review actions
HIPAA_AUDIT_LOG_ENABLED=true
